{
  "name": "bagga-fitness",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BAGGA FITNESS — premium responsive gym website (React + Vite + Tailwind)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "dev:app": "vite --mode app",
    "build:app": "vite build --mode app",
    "sync": "npm run build:app && cap sync",
    "android": "npm run sync && cap open android",
    "android:apk": "npm run sync && cd android && .\\gradlew.bat assembleDebug",
    "android:bundle": "npm run sync && cd android && .\\gradlew.bat bundleRelease",
    "ios": "npm run sync && cap open ios",
    "assets": "capacitor-assets generate --android --ios && node scripts/fix-adaptive-icon.mjs",
    "assets:android": "capacitor-assets generate --android && node scripts/fix-adaptive-icon.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/oswald": "^5.1.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  }
}
